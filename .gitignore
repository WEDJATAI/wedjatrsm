# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# R16: tool artifact directory (session scratch)
/tool-results/

# R16 hardening: live DB + snapshots are NEVER tracked — a git checkout
# of an old commit can no longer clobber live data. Snapshots live on disk
# (backups/, VACUUM INTO engine) and in git history pre-R16.
/db/*.db*
/backups/

# R16: git bundles are offline artifacts — never tracked (a committed bundle
# snowballs: each regeneration would contain the previous one)
*.bundle
.zscripts/dev.pid

# Task 22-c: Electron desktop packaging — everything under desktop/ that is
# GENERATED. The tracked sources are desktop/package.json, main.js,
# preload.js, prepare-server.mjs, README.md and resources/icon.png;
# node_modules/, server/ (assembled by prepare-server.mjs), dist/
# (electron-builder output) and resources/seed.db (staged by CI from
# download/rsm-platform-database.db — never commit a database binary) are not.
/desktop/node_modules/
/desktop/server/
/desktop/dist/
/desktop/resources/seed.db


# R22: tool/agent artifacts never tracked (public-repo hygiene)
/.agent-screens/
/upload/
/dev.log*
