local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# R16: tool artifact directory (session scratch)
/tool-results/

# R16 hardening: live DB + snapshots are NEVER tracked — a git checkout
# of an old commit can no longer clobber live data. Snapshots live on disk
# (backups/, VACUUM INTO engine) and in git history pre-R16.
/db/*.db*
/backups/
